# App Settings
APP_NAME=Doc Converter
HOST=0.0.0.0
PORT=8000
DEBUG=true

# Storage Directories (Absolute or relative paths)
UPLOAD_DIR=./uploads
OUTPUT_DIR=./outputs
TMP_DIR=./tmp
MAX_UPLOAD_MB=500
PURGE_AGE_HOURS=24

# Redis / RQ Queue
REDIS_URL=redis://localhost:6379/0
RQ_QUEUE=doc-jobs

# LibreOffice & Gotenberg
SOFFICE_PATH=soffice  # or C:\Program Files\LibreOffice\program\soffice.exe
GOTENBERG_URL=http://localhost:3000

# External Tools
POPPLER_PATH=
PANDOC_PATH=
GHOSTSCRIPT_PATH=

# Google Gemini Intelligence & Summarization (Task 3)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash
