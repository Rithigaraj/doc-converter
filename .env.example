# App
APP_NAME=doc-converter
HOST=0.0.0.0
PORT=8000
DEBUG=true

# Storage
UPLOAD_DIR=./uploads
OUTPUT_DIR=./outputs
TMP_DIR=./tmp
MAX_UPLOAD_MB=500
PURGE_AGE_HOURS=24

# Redis/RQ
REDIS_URL=redis://localhost:6379/0
RQ_QUEUE=doc-jobs

# LibreOffice / Gotenberg
SOFFICE_PATH=soffice  # or C:\Program Files\LibreOffice\program\soffice.exe
GOTENBERG_URL=http://localhost:3000

# Poppler (pdf2image)
POPPLER_PATH=


# External tools
PANDOC_PATH=
GHOSTSCRIPT_PATH=
